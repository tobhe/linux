	ap_flash_wp_pin: ap-flash-wp-pins {
		pins-bus {
			pinmux = <PINMUX_GPIO3__FUNC_GPIO3>;
			bias-disable;
		};
	};

	touchscreen_pins: touchscreen-pins {
		pins-int {
			pinmux = <PINMUX_GPIO7__FUNC_GPIO7>;
			bias-disable; /* Has external pullup */
		};

		pins-reset {
			pinmux = <PINMUX_GPIO31__FUNC_GPIO31>;
			drive-strength = <2>;
		};
	};

	trackpad_pins: trackpad-pins {
		pins-int {
			pinmux = <PINMUX_GPIO8__FUNC_GPIO8>;
			bias-disable; /* Has external pullup */
		};
	};


	ec2_ap_pins: fp-pins {
		pins-enable {
			pinmux = <PINMUX_GPIO12__FUNC_GPIO12>;
			input-enable;
		};

		pins-reset {
			pinmux = <PINMUX_GPIO26__FUNC_GPIO26>;
			bias-disable;
		};

		pins-bootstrap {
			pinmux = <PINMUX_GPIO27__FUNC_GPIO27>;
			bias-disable;
		};
	};


	gsc_ap_pins: gsc-ap-pins {
		pins-int {
			pinmux = <PINMUX_GPIO18__FUNC_GPIO18>;
			input-enable;
		};
	};

	ec_ap_pins: ec-ap-pins {
		pins-int {
			pinmux = <PINMUX_GPIO19__FUNC_GPIO19>;
			input-enable;
		};
	};

	usb_en_pins: usb-en-pins {
		pins-pwr {
			pinmux = <PINMUX_GPIO28__FUNC_GPIO28>;
			bias-pull-up;
		};
	};

	i2c0_pins: i2c0-pins {
		pins-bus {
			pinmux = <PINMUX_GPIO99__FUNC_SCL0>,
				 <PINMUX_GPIO100__FUNC_SDA0>;
			bias-disable;
			drive-strength = <4>;
		};
	};

	nor_pins: nor-pins {
		pins-ck {
			pinmux = <PINMUX_GPIO102__FUNC_SF_CK>;
			bias-pull-down = <75000>;
			drive-strength = <14>;
		};

		pins-cs {
			pinmux = <PINMUX_GPIO101__FUNC_SF_CS>;
			bias-pull-up = <75000>;
			drive-strength = <14>;
		};

		pins-io {
			pinmux = <PINMUX_GPIO91__FUNC_SF_D0>,
				 <PINMUX_GPIO92__FUNC_SF_D1>;
			bias-pull-down;
			drive-strength = <14>;
		};
	};

	i2c2_pins: i2c2-pins {
		pins-bus {
			pinmux = <PINMUX_GPIO188__FUNC_SCL2>,
				 <PINMUX_GPIO189__FUNC_SDA2>;
			bias-disable;
			drive-strength = <4>;
		};
	};

	i2c4_pins: i2c4-pins {
		pins-bus {
			pinmux = <PINMUX_GPIO191__FUNC_SDA4>,
				 <PINMUX_GPIO190__FUNC_SCL4>;
			bias-disable;
			drive-strength = <4>;
		};
	};

	i2c5_pins: i2c5-pins {
		pins-bus {
			pinmux = <PINMUX_GPIO177__FUNC_SDA5>,
				 <PINMUX_GPIO176__FUNC_SCL5>;
			bias-disable;
			drive-strength = <4>;
		};
	};

	i2c6_pins: i2c6-pins {
		pins-bus {
			pinmux = <PINMUX_GPIO105__FUNC_SDA6>,
				 <PINMUX_GPIO104__FUNC_SCL6>;
			bias-disable;
			drive-strength = <4>;
		};
	};

	spi1_pins: spi1-pins {
		pins-bus {
			pinmux = <PINMUX_GPIO110__FUNC_SPI1_CLK>,
				 <PINMUX_GPIO111__FUNC_SPI1_CSB>,
				 <PINMUX_GPIO112__FUNC_SPI1_MO>,
				 <PINMUX_GPIO113__FUNC_SPI1_MI>;
			bias-disable;
		};

	};

	spi5_pins: spi5-pins {
		pins-bus {
			pinmux = <PINMUX_GPIO118__FUNC_SPI5_CLK>,
				 <PINMUX_GPIO119__FUNC_SPI5_CSB>,
				 <PINMUX_GPIO120__FUNC_SPI5_MO>;
			bias-disable;
		};

		pins-spi-mi {
			pinmux = <PINMUX_GPIO121__FUNC_SPI5_MI>;
			bias-pull-down;
		};
	};

	mmc1_pins_detect: mmc1-detect-pins {
		pins-insert {
			pinmux = <PINMUX_GPIO11__FUNC_GPIO11>;
			/* Has external pullup */
			bias-pull-none;
		};
	};

	mmc1_pins: mmc1-pins {
		pins-bus {
			pinmux = <PINMUX_GPIO126__FUNC_MSDC1_CMD>,
				 <PINMUX_GPIO127__FUNC_MSDC1_DAT0>,
				 <PINMUX_GPIO128__FUNC_MSDC1_DAT1>,
				 <PINMUX_GPIO129__FUNC_MSDC1_DAT2>,
				 <PINMUX_GPIO130__FUNC_MSDC1_DAT3>;
			input-enable;
			drive-strength = <6>;
			bias-pull-up = <MTK_PUPD_SET_R1R0_01>;
		};

		pins-clk {
			pinmux = <PINMUX_GPIO125__FUNC_MSDC1_CLK>;
			drive-strength = <6>;
			bias-pull-down = <MTK_PUPD_SET_R1R0_10>;
		};
	};

	fp_pwr_pins: fp-pwr-pins {
		pins-pwr {
			pinmux = <PINMUX_GPIO173__FUNC_GPIO173>;
			bias-pull-up;
		};
	};

	i2c1_pins: i2c1-pins {
		pins-bus {
			pinmux = <PINMUX_GPIO200__FUNC_SCL1>,
				 <PINMUX_GPIO201__FUNC_SDA1>;
			bias-disable;
			drive-strength = <4>;
		};
	};

	pcie0_pins: pcie0-pins {
		pins-bus {
			pinmux = <PINMUX_GPIO241__FUNC_PCIE_PERSTN>,
				 <PINMUX_GPIO242__FUNC_PCIE_WAKEN>,
				 <PINMUX_GPIO243__FUNC_PCIE_CLKREQN>;
			bias-pull-up;
		};

		wifi-kill {
			pinmux = <PINMUX_GPIO249__FUNC_GPIO249>;
			output-high;
		};
	};

	bt_rfkill_pins: bt-rfkill-pins {
		pins-rfkill {
			pinmux = <PINMUX_GPIO248__FUNC_GPIO248>;
			output-high;
		};
	};
};

&spi1 {
	pinctrl-names = "default";
	pinctrl-0 = <&spi1_pins>;
	mediatek,pad-select = <0>;
	status = "okay";

	cros_ec: ec@0 {
		compatible = "google,cros-ec-spi";
		reg = <0>;
		interrupts-extended = <&pio 19 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&ec_ap_pins>;
		spi-max-frequency = <3000000>;

		i2c_tunnel: i2c-tunnel {
			compatible = "google,cros-ec-i2c-tunnel";
			google,remote-bus = <1>;
			#address-cells = <1>;
			#size-cells = <0>;
		};

		typec {
			compatible = "google,cros-ec-typec";
			#address-cells = <1>;
			#size-cells = <0>;

			usb_c0: connector@0 {
				compatible = "usb-c-connector";
				reg = <0>;
				label = "left";
				power-role = "dual";
				data-role = "host";
				try-power-role = "source";
			};

			usb_c1: connector@1 {
				compatible = "usb-c-connector";
				reg = <1>;
				label = "right";
				power-role = "dual";
				data-role = "host";
				try-power-role = "source";
			};
		};
	};
};

&spi5 {
	pinctrl-names = "default";
	pinctrl-0 = <&spi5_pins>;
	mediatek,pad-select = <0>;

	cros_ec_fp: ec@0 {
		compatible = "google,cros-ec-fp", "google,cros-ec-spi";
		reg = <0>;
		interrupts-extended = <&pio 12 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&ec2_ap_pins>;
		reset-gpios = <&pio 26 GPIO_ACTIVE_LOW>;
		boot0-gpios = <&pio 27 GPIO_ACTIVE_LOW>;
		spi-max-frequency = <3000000>;
		spi-cs-setup-delay-ns = <10>;
		vdd-supply = <&pp3300_fp>;
		status = "disabled";
	};
};

&spmi1 {
	pmic@6 {
		compatible = "mediatek,mt6316c-regulator";
		reg = <0x6 SPMI_USID>;
		#address-cells = <0>;

		mt6316cp_vbuck0: vbuck124 {
			regulator-name = "dvdd_proc_m";
			regulator-min-microvolt = <450000>;
			regulator-max-microvolt = <12775000>;
			regulator-enable-ramp-delay = <256>;
			regulator-always-on;
		};

		mt6316cp_vbuck1: vbuck3 {
			regulator-name = "emi_vdd2h";
			regulator-min-microvolt = <1010000>;
			regulator-max-microvolt = <1122500>;
			regulator-enable-ramp-delay = <256>;
			regulator-always-on;
		};
	};

	pmic@7 {
		compatible = "mediatek,mt6316d-regulator";
		reg = <0x7 SPMI_USID>;
		#address-cells = <0>;

		mt6316dp_vbuck0: vbuck1234 {
			regulator-enable-ramp-delay = <256>;
			regulator-name = "dvdd_gpustack";
			regulator-max-microvolt = <935000>;
			regulator-min-microvolt = <490000>;
		};
	};

	pmic@8 {
		compatible = "mediatek,mt6316b-regulator";
		reg = <0x8 SPMI_USID>;
		#address-cells = <0>;

		mt6316vp_vbuck0: vbuck12 {
			regulator-name = "dvdd_core";
			regulator-min-microvolt = <450000>;
			regulator-max-microvolt = <965000>;
			regulator-enable-ramp-delay = <256>;
			regulator-always-on;
		};

		mt6316vp_vbuck1: vbuck34 {
			regulator-name = "dvdd_proc_l";
			regulator-min-microvolt = <450000>;
			regulator-max-microvolt = <1175000>;
			regulator-enable-ramp-delay = <256>;
			regulator-always-on;
		};
	};

	pmic@f {
		compatible = "mediatek,mt6316c-regulator";
		reg = <0xf SPMI_USID>;
		#address-cells = <0>;

		mt6316kp_vbuck0: vbuck124 {
			regulator-name = "dvdd_proc_b";
			regulator-min-microvolt = <450000>;
			regulator-max-microvolt = <1277500>;
			regulator-enable-ramp-delay = <256>;
			regulator-always-on;
		};

		mt6316kp_vbuck1: vbuck3 {
			regulator-name = "dvdd_sram_proc_all";
			regulator-min-microvolt = <672500>;
			regulator-max-microvolt = <827500>;
			regulator-enable-ramp-delay = <256>;
			regulator-always-on;
		};
	};
};

&ssusb0 {
	dr_mode = "host";
	vusb33-supply = <&mt6373_vusb>;
	status = "okay";
};

&ssusb1 {
	dr_mode = "host";
	vusb33-supply = <&mt6373_vusb>;
	status = "okay";
};

&u2phy0 {
	status = "okay";
};

&u2phy1 {
	status = "okay";
};

&u3phy0 {
	status = "okay";
};

&uart0 {
	status = "okay";
};

&uart1 {
	status = "okay";
};

&ufshci {
	vcc-supply = <&mt6363_vemc>;
	vccq-supply = <&mt6363_vufs12>;
	vccq2-supply = <&mt6363_vufs18>;
	status = "okay";
};

&ufsphy {
	status = "okay";
};

&xhci0 {
	usb2-lpm-disable;
	vbus-supply = <&pp5000_usb>;
};

&xhci1 {
	usb2-lpm-disable;
	vbus-supply = <&mt6373_vcn33_1>;
};

#include <arm/cros-ec-keyboard.dtsi>
#include <arm/cros-ec-sbs.dtsi>
