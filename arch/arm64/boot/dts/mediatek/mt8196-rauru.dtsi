	ap_flash_wp_pin: ap-flash-wp-pins {
		pins-bus {
			pinmux = <PINMUX_GPIO3__FUNC_GPIO3>;
			bias-disable;
		};
	};

	backlight_en_pin: backlight-en-pins {
		pins-enable {
			pinmux = <PINMUX_GPIO216__FUNC_GPIO216>;
		};
	};

	dp_hpd_pin: dp-hpd-pins {
		pins-hpd {
			pinmux = <PINMUX_GPIO32__FUNC_DP_TX_HPD>;
		};
	};

	ec_int_pin: ec-int-pins {
		pins-ec-int {
			pinmux = <PINMUX_GPIO19__FUNC_GPIO19>;
			input-enable;
		};
	};

	edp_hpd_pin: edp-hpd-pins {
		pins-edp-hpd {
			pinmux = <PINMUX_GPIO13__FUNC_EDP_TX_HPD>;
			/* TODO: check this. EVB is using bias-pull-up. */
			//bias-disable;
			bias-pull-up;
		};
	};

	fp_pwr_pin: fp-pwr-pins {
		pins-enable {
			pinmux = <PINMUX_GPIO173__FUNC_GPIO173>;
			bias-pull-up;
		};
	};

	fp_pin: fp-pins {
		pins-enable {
			pinmux = <PINMUX_GPIO12__FUNC_GPIO12>;
			input-enable;
		};
	};

	fp_rst_pin: fp-rst-pins {
		pins-reset {
			pinmux = <PINMUX_GPIO26__FUNC_GPIO26>;
			bias-disable;
		};
	};

	fp_fw_up_pin: fp-fw-up-pins {
		pins-bootstrap {
			pinmux = <PINMUX_GPIO27__FUNC_GPIO27>;
			bias-disable;
		};
	};

	gsc_ap_int_pin: gsc-ap-int-pins {
		pins-int {
			pinmux = <PINMUX_GPIO18__FUNC_GPIO18>;
			input-enable;
		};
	};

	i2c0_pins: i2c0-pins {
		pins-bus {
			pinmux = <PINMUX_GPIO100__FUNC_SDA0>,
				 <PINMUX_GPIO99__FUNC_SCL0>;
			bias-disable;
			drive-strength = <4>;
		};
	};

	i2c1_pins: i2c1-pins {
		pins-bus {
			pinmux = <PINMUX_GPIO201__FUNC_SDA1>,
				 <PINMUX_GPIO200__FUNC_SCL1>;
			bias-disable;
			drive-strength = <4>;
		};
	};

	i2c2_pins: i2c2-pins {
		pins-bus {
			pinmux = <PINMUX_GPIO189__FUNC_SDA2>,
				 <PINMUX_GPIO188__FUNC_SCL2>;
			bias-disable;
			drive-strength = <4>;
		};
	};

	i2c3_pins: i2c3-pins {
		pins-bus {
			pinmux = <PINMUX_GPIO124__FUNC_SDA3>,
				 <PINMUX_GPIO123__FUNC_SCL3>;
			bias-disable;
			drive-strength = <4>;
		};
	};

	i2c4_pins: i2c4-pins {
		pins-bus {
			pinmux = <PINMUX_GPIO191__FUNC_SDA4>,
				 <PINMUX_GPIO190__FUNC_SCL4>;
			bias-disable;
			drive-strength = <4>;
		};
	};

	i2c5_pins: i2c5-pins {
		pins-bus {
			pinmux = <PINMUX_GPIO177__FUNC_SDA5>,
				 <PINMUX_GPIO176__FUNC_SCL5>;
			bias-disable;
			drive-strength = <4>;
		};
	};

	i2c6_pins: i2c6-pins {
		pins-bus {
			pinmux = <PINMUX_GPIO105__FUNC_SDA6>,
				 <PINMUX_GPIO104__FUNC_SCL6>;
			bias-disable;
			drive-strength = <4>;
		};
	};

	i2c7_pins: i2c7-pins {
		pins-bus {
			pinmux = <PINMUX_GPIO195__FUNC_SDA7>,
				 <PINMUX_GPIO194__FUNC_SCL7>;
			bias-disable;
			drive-strength = <4>;
		};
	};

	mmc1_pins: mmc1-pins {
		pins-bus {
			pinmux = <PINMUX_GPIO126__FUNC_MSDC1_CMD>,
				 <PINMUX_GPIO127__FUNC_MSDC1_DAT0>,
				 <PINMUX_GPIO128__FUNC_MSDC1_DAT1>,
				 <PINMUX_GPIO129__FUNC_MSDC1_DAT2>,
				 <PINMUX_GPIO130__FUNC_MSDC1_DAT3>;
			input-enable;
			drive-strength = <6>;
			bias-pull-up = <MTK_PUPD_SET_R1R0_01>;
		};

		pins-clk {
			pinmux = <PINMUX_GPIO125__FUNC_MSDC1_CLK>;
			drive-strength = <6>;
			bias-pull-down = <MTK_PUPD_SET_R1R0_10>;
		};

		pins-insert {
			pinmux = <PINMUX_GPIO11__FUNC_GPIO11>;
			bias-pull-none; /* Has external pullup */
		};
	};

	nau8825_pins: nau8825-pins {
		pins-int {
			pinmux = <PINMUX_GPIO10__FUNC_GPIO10>;
			input-enable;
			bias-pull-up;
		};
	};

	nor_pins: nor-pins {
		pins-ck {
			pinmux = <PINMUX_GPIO102__FUNC_SF_CK>;
			bias-pull-down = <MTK_PULL_SET_RSEL_000>;
			mediatek,rsel = <7>;
			drive-strength = <14>;
		};

		pins-cs {
			pinmux = <PINMUX_GPIO101__FUNC_SF_CS>;
			bias-pull-up = <MTK_PULL_SET_RSEL_000>;
			mediatek,rsel = <7>;
			drive-strength = <14>;
		};

		pins-io {
			pinmux = <PINMUX_GPIO91__FUNC_SF_D0>,
				 <PINMUX_GPIO92__FUNC_SF_D1>;
			bias-pull-down;
			drive-strength = <14>;
		};
	};

	pcie0_pins: pcie0-pins {
		pins-bus {
			pinmux = <PINMUX_GPIO241__FUNC_PCIE_PERSTN>,
				 <PINMUX_GPIO242__FUNC_PCIE_WAKEN>,
				 <PINMUX_GPIO243__FUNC_PCIE_CLKREQN>;
			bias-pull-up;
		};

		wifi-kill {
			pinmux = <PINMUX_GPIO249__FUNC_GPIO249>;
			output-high;
		};
	};

	pcie1_pins: pcie1-pins {
		pins-bus {
			pinmux = <PINMUX_GPIO145__FUNC_PCIE_WAKEN_1P>,
				 <PINMUX_GPIO146__FUNC_PCIE_PERSTN_1P>,
				 <PINMUX_GPIO147__FUNC_PCIE_CLKREQN_1P>;
			bias-pull-up = <MTK_PUPD_SET_R1R0_01>;
		};
	};

	pwm_pin: pwm-pins {
		pins-pwm {
			pinmux = <PINMUX_GPIO103__FUNC_DISP_PWM>;
		};
	};

	spi1_pins: spi1-pins {
		pins-bus {
			pinmux = <PINMUX_GPIO110__FUNC_SPI1_CLK>,
				 <PINMUX_GPIO111__FUNC_SPI1_CSB>,
				 <PINMUX_GPIO112__FUNC_SPI1_MO>,
				 <PINMUX_GPIO113__FUNC_SPI1_MI>;
			bias-disable;
		};
	};

	spi5_pins: spi5-pins {
		pins-bus {
			pinmux = <PINMUX_GPIO118__FUNC_SPI5_CLK>,
				 <PINMUX_GPIO119__FUNC_SPI5_CSB>,
				 <PINMUX_GPIO120__FUNC_SPI5_MO>;
			bias-disable;
		};

		pins-spi-mi {
			pinmux = <PINMUX_GPIO121__FUNC_SPI5_MI>;
			bias-pull-down;
		};
	};

	trackpad_int_pin: trackpad-int-pins {
		pins-int {
			pinmux = <PINMUX_GPIO8__FUNC_GPIO8>;
			bias-disable; /* Has external pullup */
		};
	};

	touchscreen_pins: touchscreen-pins {
		pins-int {
			pinmux = <PINMUX_GPIO7__FUNC_GPIO7>;
			bias-disable; /* Has external pullup */
		};

		pins-reset {
			pinmux = <PINMUX_GPIO31__FUNC_GPIO31>;
			drive-strength = <2>;
		};
	};

	usb_init_done_pins: usb-init-done-pins {
		pins-enable {
			pinmux = <PINMUX_GPIO28__FUNC_GPIO28>;
			bias-pull-up;
		};

		bt-kill {
			pinmux = <PINMUX_GPIO248__FUNC_GPIO248>;
			output-high;
		};
	};
};

&spi1 {
	pinctrl-names = "default";
	pinctrl-0 = <&spi1_pins>;
	mediatek,pad-select = <0>;

	status = "okay";

	cros_ec: ec@0 {
		compatible = "google,cros-ec-spi";
		reg = <0>;
		interrupts-extended = <&pio 19 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&ec_int_pin>;
		spi-max-frequency = <3000000>;
		#thermal-sensor-cells = <1>;
		#cooling-cells = <2>;

		i2c_tunnel: i2c-tunnel {
			compatible = "google,cros-ec-i2c-tunnel";
			google,remote-bus = <1>;
			#address-cells = <1>;
			#size-cells = <0>;
		};

		cros_ec_typec: typec {
			compatible = "google,cros-ec-typec";
			#address-cells = <1>;
			#size-cells = <0>;

			usb_c0: connector@0 {
				compatible = "usb-c-connector";
				reg = <0>;
				label = "left";
				power-role = "dual";
				data-role = "host";
				try-power-role = "source";
			};

			usb_c1: connector@1 {
				compatible = "usb-c-connector";
				reg = <1>;
				label = "right";
				power-role = "dual";
				data-role = "host";
				try-power-role = "source";
			};
		};
	};
};

spi_ap_fp: &spi5 {
	pinctrl-names = "default";
	pinctrl-0 = <&spi5_pins>;
	mediatek,pad-select = <0>;

	status = "okay";

	cros_ec_fp: ec@0 {
		compatible = "google,cros-ec-fp", "google,cros-ec-spi";
		reg = <0>;
		interrupts-extended = <&pio 12 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&fp_pin>, <&fp_rst_pin>, <&fp_fw_up_pin>;
		reset-gpios = <&pio 26 GPIO_ACTIVE_LOW>;
		boot0-gpios = <&pio 27 GPIO_ACTIVE_LOW>;
		spi-max-frequency = <3000000>;
		spi-cs-setup-delay-ns = <10>;
		vdd-supply = <&pp3300_fp>;
	};
};

&uart0 {
	status = "okay";
};

&uart1 {
	status = "okay";
};

&u2phy0 {
	status = "okay";
};

&u2phy1 {
	status = "okay";
};

&u3phy0 {
	status = "okay";
};

&xhci0 {
	vbus-supply = <&pp5000_usb>;
	usb2-lpm-disable;

	status = "okay";
};

&xhci1 {
	vbus-supply = <&mt6373_vcn33_1>;
	usb2-lpm-disable;

	status = "okay";
	hub@2 {
		compatible = "usb1da0,55a1";
		reg = <2>;

		bluetooth@5 {
				compatible = "usb0489,e111";
				reg = <5>;
				reset-gpios = <&pio 248 GPIO_ACTIVE_LOW>;
		};
	};
};

#include <arm/cros-ec-keyboard.dtsi>
#include <arm/cros-ec-sbs.dtsi>
