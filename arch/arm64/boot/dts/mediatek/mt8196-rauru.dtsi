/dts-v1/;
#include "mt8196.dtsi"
#include "mt6316.dtsi"
#include "mt6363.dtsi"
#include "mt6373.dtsi"
#include "mt6685.dtsi"
#include <dt-bindings/pinctrl/mt8196-pinfunc.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/input/gpio-keys.h>

/ {
	chosen: chosen {
		stdout-path = "serial0:115200n8";
	};

	backlight: backlight {
		compatible = "pwm-backlight";
		pinctrl-names = "default";
		pinctrl-0 = <&backlight_en_pin>;
		pwms = <&disp_pwm0 0 500000>;
		power-supply = <&ppvar_edp_bl_s3>;
		enable-gpios = <&pio 216 GPIO_ACTIVE_HIGH>;
		brightness-levels = <0 1023>;
		num-interpolated-steps = <1023>;
		default-brightness-level = <576>;
	};

	dmic_codec: dmic-codec {
		compatible = "dmic-codec";
		#sound-dai-cells = <0>;
		num-channels = <2>;
		wakeup-delay-ms = <100>;
	};

	/* system wide LDO 3.3V power rail */
	pp3300_ldo_z5: regulator-pp3300-ldo-z5 {
		compatible = "regulator-fixed";
		regulator-name = "pp3300_ldo_z5";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&ppvar_sys>;
	};

	/* system wide LDO 5.0V power rail */
	pp5000_ldo_z5: regulator-pp5000-ldo-z5 {
		compatible = "regulator-fixed";
		regulator-name = "pp5000_ldo_z5";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		vin-supply = <&ppvar_sys>;
	};

	/* separately switched 3.3V power rail */
	pp3300_ssd_s3: regulator-pp3300-ssd-s3 {
		compatible = "regulator-fixed";
		regulator-name = "pp3300_ssd_s3";
		/* automatically sequenced by PMIC EXT_PMIC_EN2_3V7 */
		regulator-always-on;
		regulator-boot-on;
		vin-supply = <&pp3300_z1>;
	};

	/* separately switched 3.3V power rail */
	pp3300_wlan_s3: regulator-pp3300-wlan-s3 {
		compatible = "regulator-fixed";
		regulator-name = "pp3300_wlan_s3";
		/* automatically sequenced by PMIC EXT_PMIC_EN2_3V7 */
		regulator-always-on;
		regulator-boot-on;
		vin-supply = <&pp3300_z1>;
	};

	/* separately switched 3.3V power rail */
	pp3300_fp: regulator-pp3300-fp {
		compatible = "regulator-fixed";
		regulator-name = "pp3300_fp";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		pinctrl-names = "default";
		pinctrl-0 = <&fp_pwr_pin>;
		vin-supply = <&pp3300_z1>;
	};

	/* separately switched 3.3V power rail */
	pp3300_hdmi: regulator-pp3300-hdmi {
		compatible = "regulator-fixed";
		regulator-name = "pp3300_hdmi";
		/* EN_HDMI_PWR controlled by EC */
		regulator-always-on;
		regulator-boot-on;
		vin-supply = <&pp3300_z1>;
	};

	/* system wide 3.3V power rail */
	pp3300_z1: regulator-pp3300-z1 {
		compatible = "regulator-fixed";
		regulator-name = "pp3300_z1";
		/* controlled by EC */
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&ppvar_sys>;
	};

	/* system wide 3.7V power rail */
	pp3700_s5: regulator-pp3700-s5 {
		compatible = "regulator-fixed";
		regulator-name = "pp3700_s5";
		/* EN_PP3700_S5 controlled by EC */
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3700000>;
		regulator-max-microvolt = <3700000>;
		vin-supply = <&ppvar_sys>;
	};

	/* system wide 5.0V power rail */
	pp5000_z1: regulator-pp5000-z1 {
		compatible = "regulator-fixed";
		regulator-name = "pp5000_z1";
		/* EN_PP5000_Z1 controlled by EC */
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		vin-supply = <&ppvar_sys>;
	};

	/* separately switched 5.0V power rail */
	pp5000_hdmi: regulator-pp5000-hdmi {
		compatible = "regulator-fixed";
		regulator-name = "pp5000_hdmi";
		/* EN_HDMI_PWR controlled by EC */
		regulator-always-on;
		regulator-boot-on;
		vin-supply = <&pp5000_z1>;
	};

	/* separately switched 5.0V power rail */
	pp5000_usb: regulator-pp5000-usb {
		compatible = "regulator-fixed";
		regulator-name = "pp5000_usb";
		regulator-always-on;
		regulator-boot-on;
		enable-active-high;
		gpio = <&pio 28 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&usb_init_done_pins>;
		vin-supply = <&pp5000_z1>;
	};

	/* system wide semi-regulated power rail from battery or USB */
	ppvar_edp_bl_s3:
	ppvar_sys: regulator-ppvar-sys {
		compatible = "regulator-fixed";
		regulator-name = "ppvar_sys";
		regulator-always-on;
		regulator-boot-on;
	};

	nau8318: speaker-codec {
		compatible = "nuvoton,nau8318";
		enable-gpios = <&pio 174 0>;/* EN_SPKR */
		beep-enable-gpios = <&pio 175 0>;/* BEEP_ON */
		#sound-dai-cells = <0>;

		status = "disabled";
	};

};

&adsp {
	memory-region = <&adsp_dma_mem_reserved>,
			<&adsp_mem_reserved>;
	pinctrl-names = "default";
	status = "okay";
};

&afe {
	memory-region = <&afe_dma_mem_reserved>;
	status = "disabled";
};

&cpu0 {
	proc-supply = <&mt6316_8_vbuck3>;
};

&cpu1 {
	proc-supply = <&mt6316_8_vbuck3>;
};

&cpu2 {
	proc-supply = <&mt6316_8_vbuck3>;
};

&cpu3 {
	proc-supply = <&mt6316_8_vbuck3>;
};

&cpu4 {
	proc-supply = <&mt6316_6_vbuck1>;
};

&cpu5 {
	proc-supply = <&mt6316_6_vbuck1>;
};

&cpu6 {
	proc-supply = <&mt6316_6_vbuck1>;
};

&cpu7 {
	proc-supply = <&mt6316_15_vbuck1>;
};

&disp_dvo0 {
	status = "okay";

	ports {
		port {
			disp_dvo0_out: endpoint {
				remote-endpoint = <&edp_in>;
			};
		};
	};
};

&disp_pwm0 {
	pinctrl-names = "default";
	pinctrl-0 = <&pwm_pin>;

	status = "okay";
};

&dp_intf0 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			disp1_dp_intf0_out: endpoint {
				remote-endpoint = <&dptx_in0>;
			};
		};
	};
};

&dp_intf1 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			disp1_dp_intf1_out: endpoint {
				remote-endpoint = <&dptx_in1>;
			};
		};
	};
};

&dp_tx {
	#sound-dai-cells = <0>;
	pinctrl-names = "default";
	pinctrl-0 = <&dp_hpd_pin>;
	direct-dp;

	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			dptx_in0: endpoint {
				remote-endpoint = <&disp1_dp_intf0_out>;
			};
		};

		port@1 {
			reg = <1>;
			dptx_in1: endpoint {
				remote-endpoint = <&disp1_dp_intf1_out>;
			};
		};

		port@2 {
			reg = <2>;
			dptx_out: endpoint {
				data-lanes = <0 1 2 3>;
			};
		};
	};
};

&edp_tx {
	pinctrl-names = "default";
	pinctrl-0 = <&edp_hpd_pin>;

	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			edp_in: endpoint {
				remote-endpoint = <&disp_dvo0_out>;
			};
		};

		port@1 {
			reg = <1>;
			edp_out: endpoint {
				data-lanes = <0 1 2 3>;
				remote-endpoint = <&edp_panel_in>;
			};
		};
	};

	aux-bus {
		panel: panel {
			compatible = "edp-panel";
			power-supply = <&mt6373_vcn33_3>;
			backlight = <&backlight>;

			status = "okay";

			port {
				edp_panel_in: endpoint {
					remote-endpoint = <&edp_out>;
				};
			};
		};
	};
};

&pcie0 {
	pinctrl-names = "default";
	pinctrl-0 = <&pcie0_pins>;
	status = "okay";
};

&pcie1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pcie1_pins>;
	/* pcie1 for SSD is reserved but unused. */
	status = "disabled";
};

&pciephy0 {
	status = "okay";
};

&mt6373_vaux18 {
	regulator-name = "avss18_auxadc_mt6373";
	regulator-min-microvolt = <1800000>;
	regulator-max-microvolt = <1800000>;
};

&mt6373_vefuse {
	regulator-name = "pp1800_vefuse";
	regulator-min-microvolt = <1800000>;
	regulator-max-microvolt = <1800000>;
};

&mt6363_vio18 {
	regulator-name = "pp1800_vio18_s3";
	regulator-min-microvolt = <1800000>;
	regulator-max-microvolt = <1800000>;
};

&mt6373_vmc {
	regulator-name = "pp1800_2900_vmc";
	regulator-min-microvolt = <1800000>;
	regulator-max-microvolt = <2900000>;

	status = "okay";
};

&mt6373_vmch_eint_high {
	regulator-name = "pp2900_sd";
	/* TODO: Confirm with HW */
	regulator-min-microvolt = <1200000>;
	regulator-max-microvolt = <2900000>;

	status = "okay";
};

&mt6373_vsim1 {
	regulator-name = "pp1800_tchscr";
	regulator-min-microvolt = <1800000>;
	regulator-max-microvolt = <1800000>;
};

&mt6373_vcn33_1 {
	regulator-name = "pp3300_ucam";
	regulator-min-microvolt = <3300000>;
	regulator-max-microvolt = <3300000>;
};

&mt6373_vcn33_2 {
	regulator-name = "pp3300_tchpad";
	regulator-min-microvolt = <3300000>;
	regulator-max-microvolt = <3300000>;

	/* HACK: b/333996526 */
	regulator-always-on;

	status = "okay";
};

&mt6373_vcn33_3 {
	regulator-name = "pp3300_edp";
	regulator-min-microvolt = <3300000>;
	regulator-max-microvolt = <3300000>;

	regulator-always-on;

	status = "okay";
};

&mt6373_vtp {
	regulator-name = "pp3300_tchscr";
	regulator-min-microvolt = <3300000>;
	regulator-max-microvolt = <3300000>;

	status = "okay";
};

&mt6373_vusb {
	regulator-name = "pp3070_vusb";
	regulator-min-microvolt = <3000000>;
	regulator-max-microvolt = <3000000>;
};

/* trackpad */
&i2c0 {
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c0_pins &trackpad_int_pin>;

	status = "okay";

	/* elan trackpad */
	trackpad_elan: trackpad@15 {
		compatible = "elan,ekth3000";
		reg = <0x15>;
		interrupts-extended = <&pio 8 IRQ_TYPE_LEVEL_LOW>;
		vcc-supply = <&mt6373_vcn33_2>;
		wakeup-source;
	};

	/* synaptics trackpad */
	trackpad_synaptics: trackpad@2c  {
		compatible = "hid-over-i2c";
		reg = <0x2c>;
		interrupts-extended = <&pio 8 IRQ_TYPE_LEVEL_LOW>;
		hid-descr-addr = <0x20>;
		vdd-supply = <&mt6373_vcn33_2>;
		wakeup-source;
	};
};

/* tpm */
&i2c1 {
	clock-frequency = <1000000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c1_pins>;

	status = "okay";

	tpm@50 {
		/* TODO: Upstream adding the "ti50" compatible */
		compatible = "google,ti50", "google,cr50";
		reg = <0x50>;
		interrupts-extended = <&pio 18 IRQ_TYPE_EDGE_RISING>;
		pinctrl-names = "default";
		pinctrl-0 = <&gsc_ap_int_pin>;
	};
};

/* touchscreen */
&i2c2 {
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c2_pins>;

	status = "okay";

	touchscreen: touchscreen@41 {
		compatible = "ilitek,ili2901";
		reg = <0x41>;
		interrupts-extended = <&pio 7 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&touchscreen_pins>;
		reset-gpios = <&pio 31 GPIO_ACTIVE_LOW>;
		vcc33-supply = <&mt6373_vtp>;
	};
};

/* audio */
&i2c3 {
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c3_pins>;

	status = "okay";

	nau8825: audio-codec@1a {
		#sound-dai-cells = <0>;
		compatible = "nuvoton,nau8825";
		reg = <0x1a>;
		interrupts-extended = <&pio 10 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&nau8825_pins>;

		nuvoton,jkdet-enable;
		nuvoton,jkdet-polarity = <1>;
		nuvoton,vref-impedance = <2>;
		nuvoton,micbias-voltage = <6>;
		nuvoton,sar-threshold-num = <4>;
		nuvoton,sar-threshold = <0xc 0x1e 0x38 0x60>;
		nuvoton,sar-hysteresis = <1>;
		nuvoton,sar-voltage = <0>;
		nuvoton,sar-compare-time = <0>;
		nuvoton,sar-sampling-time = <0>;
		nuvoton,short-key-debounce = <2>;
		nuvoton,jack-insert-debounce = <7>;
		nuvoton,jack-eject-debounce = <7>;
		nuvoton,adc-delay-ms = <300>;

		status = "disabled";
	};
};

/* sar */
&i2c4 {
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c4_pins>;

	status = "okay";
};

/* EC HID keyboard */
&i2c5 {
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c5_pins>;

	status = "okay";
};

/* eusb */
&i2c6 {
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c6_pins>;

	status = "okay";
};

&main_pmic {
	pmic-lvsys-notify {
		compatible = "mediatek,mt6363-lvsys-notify";
	};
};

&mmc1 {
	bus-width = <4>;
	cap-sd-highspeed;
	cd-gpios = <&pio 11 GPIO_ACTIVE_LOW>;
	max-frequency = <200000000>;
	no-mmc;
	no-sdio;
	pinctrl-names = "default", "state_uhs";
	pinctrl-0 = <&mmc1_pins>;
	pinctrl-1 = <&mmc1_pins>;
	sd-uhs-sdr12;
	sd-uhs-sdr25;
	sd-uhs-sdr50;
	sd-uhs-sdr104;
	sd-uhs-ddr50;
	vmmc-supply = <&mt6373_vmch_eint_high>;
	vqmmc-supply = <&mt6373_vmc>;
};

&mt6363_vbuck1 {
	regulator-always-on;
};

&mt6363_vbuck2 {
	regulator-always-on;
};

&mt6363_vbuck4 {
	regulator-always-on;
};

&mt6363_vbuck6 {
	regulator-always-on;
};

&mt6363_vsram_modem {
	regulator-always-on;
};

&mt6363_vsram_cpub {
	regulator-always-on;
};

&mt6363_vsram_cpul {
	regulator-always-on;
};

&mt6363_vsram_apu {
	regulator-always-on;
};

&mt6363_vemc {
	regulator-always-on;
};

&mt6363_vufs12 {
	regulator-always-on;
};

&mt6363_vufs18 {
	regulator-always-on;
};

&mt6363_vm18 {
	regulator-always-on;
};

&mt6373_vbuck0 {
	/delete-property/ regulator-always-on;
};

&mt6373_vbuck2 {
	regulator-always-on;
};

&mt6373_vbuck4 {
	regulator-always-on;
};

&mt6373_vbuck5 {
	regulator-always-on;
};

&mt6373_vbuck6 {
	regulator-always-on;
};

&mt6373_vbuck7 {
	regulator-always-on;
};

&mt6373_vbuck4_ufs {
	status = "disabled";
};

&mt6685_rtc {
	status = "okay";
};

&mt6363_vbuck1_sshub {
	status = "disabled";
};

&mt6363_vbuck2_sshub {
	status = "disabled";
};

&mt6363_vbuck4_sshub {
	status = "disabled";
};

&nor_flash {
	pinctrl-names = "default";
	pinctrl-0 = <&nor_pins>;

	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <52000000>;
		spi-rx-bus-width = <2>;
		spi-tx-bus-width = <2>;
	};
};

&pio {
	/* pinctrl settings for pins that have no real owners. */
	pinctrl-names = "default";
	pinctrl-0 = <&ap_flash_wp_pin>;

	/* 271 lines */
	gpio-line-names =
		"STRAP_EINT0",			/* 0 */
		"PD_AP_INT_ODL",
		"STRAP_EINT2",
		/*
		 * AP_FLASH_WP_L is crossystem ABI. Schematics
		 * call it AP_WP_ODL.
		 */
		"AP_FLASH_WP_L",
		"ALS_INT_SCP_ODL",
		"LID_ACCEL_INT_SCP_L",
		"IMU_INT_SCP_L",
		"TCHSCR_INT_1V8_ODL",
		"TCHPAD_INT_ODL",
		"SPKR_INT_ODL",
		"HP_INT_ODL",			/* 10 */
		"SD_CD_AP_ODL",
		"FP_AP_INT_1V8_S3_ODL",
		"EDP_HPD_1V8",
		"SAR_INT_ODL",
		"",
		"STRAP_EINT16",
		"STRAP_EINT17",
		"GSC_AP_INT_ODL",
		"EC_AP_INT_ODL",
		"EC_AP_HID_INT_ODL",		/* 20 */
		"",
		"",
		"",
		"",
		"",
		"FP_RST_1V8_S3_L",
		"AP_FP_FW_UP_STRAP",
		"AP_XHCI_INIT_DONE",
		"AP_EC_WARM_RST_REQ",
		"TCHSCR_REPORT_DISABLE",	/* 30 */
		"TCHSCR_RST_1V8_L",
		"EC_AP_DP_HPD_OD",
		"IO_JTAG_TRST_L",
		"IO_JTAG_TDI",
		"IO_JTAG_TDO",
		"IO_JTAG_TMS",
		"",
		"",
		"I2S_HP_MCK",
		"I2S_HP_BCK",			/* 40 */
		"I2S_HP_LRCK",
		"I2S_HP_DI",
		"I2S_HP_DO",
		"",
		"",
		"",
		"",
		"",
		"",
		"",				/* 50 */
		"",
		"",
		"",
		"",
		"",
		"STRAP_AUD_DAT_MOSI0",
		"STRAP_AUD_DAT_MOSI1",
		"",
		"",
		"AP_KPCOL0",			/* 60 */
		"CPUM_PMIC_POC",
		"CPUB_PMIC_POC",
		"GPU_PMIC_POC",
		"",
		"",
		"AP_PMIC_WDTRST_L",
		"SRCLKENA0",
		"STRAP_SCP_VREQ_VAO",
		"SOC_RTC32K_1V8",
		"STRAP_FL_STROBE_EN",		/* 70 */
		"",
		"USB_EN",
		"STRAP_LVSYS_INT",
		"STRAP_FPM_IND",
		"SPMI_M_SCL",
		"SPMI_M_SDA",
		"SPMI_P_SCL",
		"SPMI_P_SDA",
		"",
		"",				/* 80 */
		"",
		"",
		"",
		"",
		"",
		"",
		"",
		"",
		"",
		"",				/* 90 */
		"SPI_AP_DO_BIOS_DI",
		"SPI_AP_DI_BIOS_DO",
		"",
		"I2S_SPKR_MCK",
		"I2S_SPKR_BCK",
		"I2S_SPKR_LRCK",
		"I2S_SPKR_DI",
		"I2S_SPKR_DO",
		"AP_I2C_TCHPAD_SCL_1V8",
		"AP_I2C_TCHPAD_SDA_1V8",	/* 100 */
		"SPI_AP_CS_BIOS_L",
		"SPI_AP_CLK_BIOS",
		"BL_PWM_1V8",
		"AP_I2C_EUSB_SCL_1V8",
		"AP_I2C_EUSB_SDA_1V8",
		"",
		"",
		"",
		"",
