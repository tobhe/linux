/dts-v1/;
#include <dt-bindings/gpio/gpio.h>
#include "mt8196.dtsi"
#include "mt6363.dtsi"
#include "mt6373.dtsi"

/ {
	aliases {
		mmc0 = &mmc1;
		serial0 = &uart0;
	};

	chosen: chosen {
		stdout-path = "serial0:115200n8";
		bootargs = "earlycon";
	};

	memory: memory@80000000 {
		device_type = "memory";
		/* The size will be filled in by the bootloader */
		reg = <0 0x80000000 0 0>;
	};

	/* system wide LDO 3.3V power rail */
	pp3300_ldo_z5: regulator-pp3300-ldo-z5 {
		compatible = "regulator-fixed";
		regulator-name = "pp3300_ldo_z5";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&ppvar_sys>;
	};

	/* system wide LDO 5.0V power rail */
	pp5000_ldo_z5: regulator-pp5000-ldo-z5 {
		compatible = "regulator-fixed";
		regulator-name = "pp5000_ldo_z5";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		vin-supply = <&ppvar_sys>;
	};

	/* separately switched 3.3V power rail */
	pp3300_ssd_s3: regulator-pp3300-ssd-s3 {
		compatible = "regulator-fixed";
		regulator-name = "pp3300_ssd_s3";
		/* automatically sequenced by PMIC EXT_PMIC_EN2_3V7 */
		regulator-always-on;
		regulator-boot-on;
		vin-supply = <&pp3300_z1>;
	};

	/* separately switched 3.3V power rail */
	pp3300_wlan_s3: regulator-pp3300-wlan-s3 {
		compatible = "regulator-fixed";
		regulator-name = "pp3300_wlan_s3";
		/* automatically sequenced by PMIC EXT_PMIC_EN2_3V7 */
		regulator-always-on;
		regulator-boot-on;
		vin-supply = <&pp3300_z1>;
	};

	/* separately switched 3.3V power rail */
	pp3300_fp: regulator-pp3300-fp {
		compatible = "regulator-fixed";
		regulator-name = "pp3300_fp";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		pinctrl-names = "default";
		pinctrl-0 = <&fp_pwr_pins>;
		vin-supply = <&pp3300_z1>;
	};

	/* separately switched 3.3V power rail */
	pp3300_hdmi: regulator-pp3300-hdmi {
		compatible = "regulator-fixed";
		regulator-name = "pp3300_hdmi";
		/* EN_HDMI_PWR controlled by EC */
		regulator-always-on;
		regulator-boot-on;
		vin-supply = <&pp3300_z1>;
	};

	/* system wide 3.3V power rail */
	pp3300_z1: regulator-pp3300-z1 {
		compatible = "regulator-fixed";
		regulator-name = "pp3300_z1";
		/* controlled by EC */
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&ppvar_sys>;
	};

	/* system wide 3.7V power rail */
	pp3700_s5: regulator-pp3700-s5 {
		compatible = "regulator-fixed";
		regulator-name = "pp3700_s5";
		/* EN_PP3700_S5 controlled by EC */
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3700000>;
		regulator-max-microvolt = <3700000>;
		vin-supply = <&ppvar_sys>;
	};

	/* system wide 5.0V power rail */
	pp5000_z1: regulator-pp5000-z1 {
		compatible = "regulator-fixed";
		regulator-name = "pp5000_z1";
		/* EN_PP5000_Z1 controlled by EC */
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		vin-supply = <&ppvar_sys>;
	};

	/* separately switched 5.0V power rail */
	pp5000_hdmi: regulator-pp5000-hdmi {
		compatible = "regulator-fixed";
		regulator-name = "pp5000_hdmi";
		/* EN_HDMI_PWR controlled by EC */
		regulator-always-on;
		regulator-boot-on;
		vin-supply = <&pp5000_z1>;
	};

	/* separately switched 5.0V power rail */
	pp5000_usb: regulator-pp5000-usb {
		compatible = "regulator-fixed";
		regulator-name = "pp5000_usb";
		regulator-always-on;
		regulator-boot-on;
		enable-active-high;
		gpio = <&pio 28 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&usb_en_pins>, <&bt_rfkill_pins>;
		vin-supply = <&pp5000_z1>;
	};

	/* system wide semi-regulated power rail from battery or USB */
	ppvar_sys: regulator-ppvar-sys {
		compatible = "regulator-fixed";
		regulator-name = "ppvar_sys";
		regulator-always-on;
		regulator-boot-on;
	};
};

&cpu0 {
	cpu-supply = <&mt6316vp_vbuck1>;
};

&cpu1 {
	cpu-supply = <&mt6316vp_vbuck1>;
};

&cpu2 {
	cpu-supply = <&mt6316vp_vbuck1>;
};

&cpu3 {
	cpu-supply = <&mt6316vp_vbuck1>;
};

&cpu4 {
	cpu-supply = <&mt6316cp_vbuck0>;
};

&cpu5 {
	cpu-supply = <&mt6316cp_vbuck0>;
};

&cpu6 {
	cpu-supply = <&mt6316cp_vbuck0>;
};

&cpu7 {
	cpu-supply = <&mt6316kp_vbuck0>;
};

&gpu {
       status = "okay";
};

&gpufreq {
       core-supply = <&mt6373_vbuck7>;
       stack-supply = <&mt6316dp_vbuck0>;
       sram-supply = <&mt6316kp_vbuck1>;
};

&i2c0 {
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c0_pins>;
	status = "okay";
};

&i2c1 {
	clock-frequency = <1000000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c1_pins>;
	status = "okay";

	tpm@50 {
		compatible = "google,ti50", "google,cr50";
		reg = <0x50>;
		interrupts-extended = <&pio 18 IRQ_TYPE_EDGE_RISING>;
		pinctrl-names = "default";
		pinctrl-0 = <&gsc_ap_pins>;
	};
};

&i2c4 {
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c4_pins>;
	status = "okay";
};

&i2c5 {
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c5_pins>;
	status = "okay";
};

&i2c6 {
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c6_pins>;

	status = "okay";
};

&mmc1 {
	bus-width = <4>;
	cap-sd-highspeed;
	cd-gpios = <&pio 11 GPIO_ACTIVE_LOW>;
	max-frequency = <200000000>;
	no-mmc;
	no-sdio;
	pinctrl-names = "default", "state_uhs";
	pinctrl-0 = <&mmc1_pins>, <&mmc1_pins_detect>;
	pinctrl-1 = <&mmc1_pins>;
	sd-uhs-ddr50;
	sd-uhs-sdr12;
	sd-uhs-sdr25;
	sd-uhs-sdr50;
	sd-uhs-sdr104;
	vmmc-supply = <&mt6373_vmch_eint_high>;
	vqmmc-supply = <&mt6373_vmc>;
};

&mt6363_vbuck1 {
	regulator-name = "dvdd_disp";
	regulator-min-microvolt = <500000>;
	regulator-max-microvolt = <825000>;
	regulator-always-on;
};

&mt6363_vbuck2 {
	regulator-name = "dvdd_mm";
	regulator-coupled-with = <&mt6363_vbuck3>;
	regulator-coupled-max-spread = <28500>;
	regulator-min-microvolt = <462500>;
	regulator-max-microvolt = <1050000>;
	regulator-always-on;
};

&mt6363_vbuck3 {
	regulator-coupled-with = <&mt6363_vbuck2>;
	regulator-coupled-max-spread = <28500>;
	regulator-min-microvolt = <462500>;
	regulator-max-microvolt = <1050000>;
	regulator-always-on;
};

&mt6363_vbuck4 {
	regulator-name = "dvdd_sram_core";
	regulator-min-microvolt = <450000>;
	regulator-max-microvolt = <825000>;
	regulator-always-on;
};

&mt6363_vbuck5 {
	regulator-always-on;
};

&mt6363_vbuck6 {
	regulator-name = "dvdd_modem";
	regulator-coupled-with = <&mt6363_vbuck7>;
	regulator-coupled-max-spread = <28500>;
	regulator-min-microvolt = <518750>;
	regulator-max-microvolt = <881250>;
	regulator-always-on;
};

&mt6363_vbuck7 {
	regulator-coupled-with = <&mt6363_vbuck6>;
	regulator-coupled-max-spread = <28500>;
	regulator-min-microvolt = <518750>;
	regulator-max-microvolt = <881250>;
	regulator-always-on;
};

&mt6363_vio18 {
	regulator-name = "pp1800_vio18_s3";
	regulator-min-microvolt = <1800000>;
	regulator-max-microvolt = <1800000>;
};

&mt6363_vm18 {
	/* TODO: Supplies EMI, should be a supplier of that, not always-on */
	regulator-always-on;
};

&mt6363_vsram_modem {
	regulator-always-on;
};

&mt6363_vsram_cpub {
	regulator-always-on;
};

&mt6363_vsram_cpum {
	regulator-always-on;
};

&mt6363_vsram_cpul {
	regulator-always-on;
};

&mt6363_vsram_apu {
	regulator-always-on;
};

&mt6373_vbuck1 {
	regulator-always-on;
};

&mt6373_vbuck2 {
	regulator-always-on;
};

&mt6373_vbuck3 {
	regulator-always-on;
};

&mt6373_vbuck4 {
	regulator-always-on;
};

&mt6373_vbuck5 {
	regulator-always-on;
};

&mt6373_vbuck6 {
	regulator-always-on;
};

&mt6373_vbuck7 {
	regulator-name = "dvdd_gpu";
	regulator-max-microvolt = <935000>;
	regulator-min-microvolt = <490000>;
};

&mt6373_vbuck8 {
	regulator-always-on;
};

&mt6373_vbuck9 {
	regulator-always-on;
};

&mt6373_vaux18 {
	regulator-name = "avss18_auxadc_mt6373";
	regulator-min-microvolt = <1800000>;
	regulator-max-microvolt = <1800000>;
};

&mt6373_vefuse {
	regulator-name = "pp1800_vefuse";
	regulator-min-microvolt = <1800000>;
	regulator-max-microvolt = <1800000>;
};

&mt6373_vmc {
	regulator-name = "pp1800_2900_vmc";
	regulator-min-microvolt = <1800000>;
	regulator-max-microvolt = <2900000>;
	regulator-allowed-modes = <0 2>;
};

&mt6373_vmch_eint_high {
	regulator-name = "pp2900_sd";
	regulator-min-microvolt = <1200000>;
	regulator-max-microvolt = <2900000>;
	regulator-allowed-modes = <0 2>;
};

&mt6373_vcn33_1 {
	regulator-name = "pp3300_ucam";
	regulator-min-microvolt = <3300000>;
	regulator-max-microvolt = <3300000>;
};

&mt6373_vcn33_2 {
	regulator-name = "pp3300_tchpad";
	regulator-min-microvolt = <3300000>;
	regulator-max-microvolt = <3300000>;

	/* HACK: b/333996526 */
	regulator-always-on;
};

&mt6373_vcn33_3 {
	regulator-name = "pp3300_edp";
	regulator-min-microvolt = <3300000>;
	regulator-max-microvolt = <3300000>;
};

&mt6373_vtp {
	regulator-name = "pp3300_tchscr";
	regulator-min-microvolt = <3300000>;
	regulator-max-microvolt = <3300000>;
};

&mt6373_vusb {
	regulator-name = "pp3070_vusb";
	regulator-min-microvolt = <3000000>;
	regulator-max-microvolt = <3000000>;
};

&nor_flash {
	pinctrl-names = "default";
	pinctrl-0 = <&nor_pins>;
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <52000000>;
		spi-rx-bus-width = <2>;
		spi-tx-bus-width = <2>;
	};
};

&pcie0 {
	pinctrl-names = "default";
	pinctrl-0 = <&pcie0_pins>;
	status = "okay";
};

&pciephy0 {
	status = "okay";
};

&pio {
	/* pinctrl settings for pins that have no real owners. */
	pinctrl-names = "default";
	pinctrl-0 = <&ap_flash_wp_pin>;

	/* 271 lines */
