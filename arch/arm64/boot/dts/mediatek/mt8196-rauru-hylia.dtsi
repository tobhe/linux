/dts-v1/;
#include "mt8196-rauru.dtsi"

/ {
	pp1000_dpbrdg: regulator-pp1000-dpbrdg {
		compatible = "regulator-fixed";
		regulator-name = "pp1000_dpbrdg";
		pinctrl-names = "default";
		pinctrl-0 = <&en_pp1000_dpbrdg_pin>;
		enable-active-high;
		//regulator-boot-on;
		gpio = <&pio 82 GPIO_ACTIVE_HIGH>;
		vin-supply = <&pp3300_z1>;
	};

	pp1800_dpbrdg: regulator-pp1800-dpbrdg {
		compatible = "regulator-fixed";
		regulator-name = "pp1800_dpbrdg";
		pinctrl-names = "default";
		pinctrl-0 = <&en_pp1800_dpbrdg_pin>;
		enable-active-high;
		//regulator-boot-on;
		gpio = <&pio 84 GPIO_ACTIVE_HIGH>;
		vin-supply = <&mt6363_vio18>;
	};

	pp3300_dpbrdg: regulator-pp3300-dp {
		compatible = "regulator-fixed";
		regulator-name = "pp3300_dpbrdg";
		pinctrl-names = "default";
		pinctrl-0 = <&en_pp3300_dpbrdg_pin>;
		enable-active-high;
		//regulator-boot-on;
		gpio = <&pio 83 GPIO_ACTIVE_HIGH>;
		vin-supply = <&pp3300_z1>;
	};

	pp1800_tchscr_report_disable: regulator-pp1800-tchscr-report-disable {
		compatible = "regulator-fixed";
		regulator-name = "pp1800_tchscr_report_disable";
		pinctrl-names = "default";
		enable-active-low;
		regulator-boot-on;
		pinctrl-0 = <&touch_report_disable_pin>;
		gpio = <&pio 30 GPIO_ACTIVE_LOW>;
	};

	pp3300_edp: regulator-pp3300-edp {
		compatible = "regulator-fixed";
		regulator-name = "pp3300_edp";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		enable-active-high;
		gpio = <&pio 172 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&en_edp_pp3300_pin>;
		vin-supply = <&pp3300_z1>;

		regulator-always-on;
	};
};

&dmic_codec {
	num-channels = <3>;
};

&afe {
	/* Only for ETDM in/out 4 */
	etdm-out-ch = <2>;
	etdm-in-ch = <2>;
	etdm-out-sync = <0>; /* 0: disable; 1: enable */
	etdm-in-sync = <0>; /* 0: disable; 1: enable */
	etdm-ip-mode = <0>; /* 0: One IP multi-channel 1: Multi-IP 2-channel */
	status = "okay";
};

&backlight {
	post-pwm-on-delay-ms = <10>;
};

&cros_ec_fp {
	spi-cs-setup-delay-ns = <43>;
	spi-cs-hold-delay-ns = <43>;
};

&cros_ec_typec {
	compatible = "google,cros-ec-ucsi";
};

&dsi0 {
	status = "okay";

	port {
		dsi_out: endpoint {
			remote-endpoint = <&anx7625_dp_in>;
		};
	};
};

&edp_tx {
	swing-level = <3>;
};

&i2c0 {
	/* carewe trackpad */
	trackpad@68 {
		compatible = "hid-over-i2c";
		reg = <0x68>;
		interrupts-extended = <&pio 8 IRQ_TYPE_LEVEL_LOW>;
		hid-descr-addr = <0x0020>;
		vdd-supply = <&mt6373_vcn33_2>;
		post-power-on-delay-ms = <50>;
		wakeup-source;
	};
};

&i2c3 {
	/delete-node/ audio-codec@1a;

	rt5650: audio-codec@1a {
		compatible = "realtek,rt5650";
		reg = <0x1a>;
		avdd-supply = <&mt6363_vio18>;
		pinctrl-names = "default";
		pinctrl-0 = <&en_codec_pwr_soc_pin>;
		cbj-sleeve-gpio = <&pio 174 GPIO_ACTIVE_HIGH>;
		interrupts-extended = <&pio 10 IRQ_TYPE_EDGE_BOTH>;
		#sound-dai-cells = <0>;
		realtek,dmic1-data-pin = <2>;
		realtek,jd-mode = <2>;
	};
};

&i2c3_pins {
	pins-bus {
		pinmux = <PINMUX_GPIO124__FUNC_SDA3>,
			 <PINMUX_GPIO123__FUNC_SCL3>;

		/delete-property/ bias-pull-up;
		bias-disable;
		drive-strength = <4>;
	};
};

&i2c4 {
	anx_bridge: anx7625@58 {
		compatible = "analogix,anx7625";
		reg = <0x58>;
		pinctrl-names = "default";
		pinctrl-0 = <&anx7625_pins>;
		enable-gpios = <&pio 81 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&pio 86 GPIO_ACTIVE_HIGH>;
		interrupts-extended = <&pio 14 IRQ_TYPE_LEVEL_LOW>;
		vdd10-supply = <&pp1000_dpbrdg>;
		vdd18-supply = <&pp1800_dpbrdg>;
		vdd33-supply = <&pp3300_dpbrdg>;
		analogix,audio-enable;
		#address-cells = <1>;
		#size-cells = <0>;
		#sound-dai-cells = <0>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;

				anx7625_dp_in: endpoint {
					remote-endpoint = <&dsi_out>;
				};
			};
		};

		switches {
			#address-cells = <1>;
			#size-cells = <0>;
			switch@0 {
				compatible = "typec-switch";
				reg = <0>;
				mode-switch;

				ports {
					#address-cells = <1>;
					#size-cells = <0>;

					port@0 {
						reg = <0>;

						anx_typec1: endpoint {
							remote-endpoint = <&typec_port1>;
						};
					};
				};
			};
		};
	};
};

&i2c5 {
	status = "disabled";
};

&keyboard_controller {
	keypad,num-columns = <18>;

	function-row-physmap = <
		MATRIX_KEY(0x00, 0x02, 0)		/* T1 */
		MATRIX_KEY(0x03, 0x02, 0)		/* T2 */
		MATRIX_KEY(0x02, 0x02, 0)		/* T3 */
		MATRIX_KEY(0x01, 0x02, 0)		/* T4 */
		MATRIX_KEY(0x04, 0x04, 0)		/* T5 */
		MATRIX_KEY(0x02, 0x04, 0)		/* T6 */
		MATRIX_KEY(0x01, 0x04, 0)		/* T7 */
		MATRIX_KEY(0x02, 0x0b, 0)		/* T8 */
		MATRIX_KEY(0x01, 0x09, 0)		/* T9 */
		MATRIX_KEY(0x00, 0x04, 0)		/* T10 */
		MATRIX_KEY(0x00, 0x01, 0)		/* T11 */
		MATRIX_KEY(0x01, 0x05, 0)		/* T12 */
		MATRIX_KEY(0x03, 0x05, 0)		/* T13 */
		MATRIX_KEY(0x00, 0x0b, 0)		/* T14 */
	>;
};

&mmc1 {
	status = "disabled";
};

&mt6363_vbuck6 {
	status = "disabled";
};

&mt6363_vbuck7 {
	status = "disabled";
};

&mt6363_vsram_mdfe {
	regulator-always-on;
};

&panel {
	power-supply = <&pp3300_edp>;
};

&pcie1 {
	status = "disabled";
};

&pciephy1 {
	status = "disabled";
};

