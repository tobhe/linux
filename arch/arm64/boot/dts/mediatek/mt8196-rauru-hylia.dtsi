	anx7625_pins: anx7625-pins {
		enable-reset-pins {
			pinmux = <PINMUX_GPIO81__FUNC_GPIO81>,
				 <PINMUX_GPIO86__FUNC_GPIO86>;
			output-low;
		};

		int-pins {
			pinmux = <PINMUX_GPIO14__FUNC_GPIO14>;
			input-enable;
			bias-pull-up;
		};
	};

	backlight_en_pin: backlight-en-pins {
		pins-enable {
			pinmux = <PINMUX_GPIO216__FUNC_GPIO216>;
			output-low;
		};
	};

	en_edp_pp3300_pin: en-edp-pp3300-pins {
		pins-enable {
			pinmux = <PINMUX_GPIO172__FUNC_GPIO172>;
			output-low;
		};
	};

	en_pp1000_dpbrdg_pin: en-pp1000-dpbrdg-pins {
		pins-enable {
			pinmux = <PINMUX_GPIO82__FUNC_GPIO82>;
			output-low;
		};
	};

	en_pp1800_dpbrdg_pin: en-pp1800-dpbrdg-pins {
		pins-enable {
			pinmux = <PINMUX_GPIO84__FUNC_GPIO84>;
			output-low;
		};
	};

	en_pp3300_dpbrdg_pin: en-pp3300-dpbrdg-pins {
		pins-enable {
			pinmux = <PINMUX_GPIO83__FUNC_GPIO83>;
			output-low;
		};
	};

	en_codec_pwr_soc_pin: en-codec-pwr-soc-pins {
		pins-enable {
			pinmux = <PINMUX_GPIO174__FUNC_GPIO174>;
			output-low;
		};
	};

	touch_report_disable_pin: touch-report-disable-pins {
		pins-disable {
			pinmux = <PINMUX_GPIO30__FUNC_GPIO30>;
			output-low;
		};
	};
};

&sound {
	compatible = "mediatek,mt8196-rt5650-sound";
	model = "mt8196_rt5650";
	mediatek,adsp = <&adsp>;
	status = "okay";

	dai-link-0 {
		link-name = "I2SOUT6_BE";
		mediatek,clk-provider = "cpu";

		codec {
			sound-dai = <&rt5650>;
		};
	};

	dai-link-1 {
		link-name = "I2SIN6_BE";
		mediatek,clk-provider = "cpu";

		codec {
			sound-dai = <&rt5650>;
		};
	};

	dai-link-2 {
		link-name = "TDM_DPTX_BE";

		codec {
			sound-dai = <&dp_tx>;
		};
	};

	dai-link-3 {
		link-name = "I2SOUT3_BE";
		mediatek,clk-provider = "cpu";

		codec {
			sound-dai = <&anx_bridge>;
		};
	};

	dai-link-4 {
		link-name = "AP_DMIC_MULTICH_BE";

		codec {
			sound-dai = <&dmic_codec>;
		};
	};
};

&therm_intf {
	mediatek,init-ttj-cpu = <105000>;
	mediatek,init-ttj-gpu = <105000>;
	mediatek,init-ttj-npu = <105000>;
};

&touchscreen {
	vccio-supply = <&pp1800_tchscr_report_disable>;
};

&trackpad_elan {
	status = "disabled";
};

&ufshci {
	/delete-property/ mediatek,ufs-rtff-mtcmos;
};

&usb_c1 {
	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@1 {
			reg = <1>;

			typec_port1: endpoint {
				remote-endpoint = <&anx_typec1>;
			};
		};
	};
};

&thermal_zones {
	reg-5v-thermal {
		polling-delay = <0>;
		polling-delay-passive = <0>;
		thermal-sensors = <&cros_ec 0>;

		trips {
			reg_5v_trip0: trip-point@0 {
				temperature = <65000>;
				hysteresis = <2000>;
				type = "hot";
			};
		};
	};

	cpu-board-thermal {
		polling-delay = <0>;
		polling-delay-passive = <0>;
		thermal-sensors = <&cros_ec 1>;

		trips {
			cpu_board_trip0: trip-point@0 {
				temperature = <75000>;
				hysteresis = <2000>;
				type = "hot";
			};
		};
	};

	charger-thermal {
		polling-delay = <0>;
		polling-delay-passive = <0>;
		thermal-sensors = <&cros_ec 2>;

		trips {
			charger_trip0: trip-point@0 {
				temperature = <75000>;
				hysteresis = <2000>;
				type = "hot";
			};
		};
	};

	ambient-thermal {
		polling-delay = <0>;
		polling-delay-passive = <0>;
		thermal-sensors = <&cros_ec 3>;

		trips {
			ambient_trip0: trip-point@0 {
				temperature = <55000>;
				hysteresis = <2000>;
				type = "hot";
			};
		};
	};
};
