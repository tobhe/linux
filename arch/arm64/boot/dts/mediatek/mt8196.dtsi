				 <&pericfg_ao_clk CLK_PERAO_FLASHIF_BCLK_FLASHIF>,
				 <&pericfg_ao_clk CLK_PERAO_FLASHIF_27M_FLASHIF>;
			clock-names = "spi", "sf", "axi", "axi_s", "bclk", "27m";
			assigned-clocks = <&cksys_clk CLK_CK_SFLASH_SEL>;
			assigned-clock-parents = <&cksys_clk CLK_CK_UNIVPLL_D6_D8>;
			interrupts = <GIC_SPI 269 IRQ_TYPE_LEVEL_HIGH 0>;
