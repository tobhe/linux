		performance: performance-controller@c2c0f20 {
			compatible = "mediatek,cpufreq-hw-v1";
			reg = <0 0xc2c0f20 0 0x120>,
			      <0 0xc2c1040 0 0x120>,
			      <0 0xc2c1160 0 0x120>;
			reg-names = "performance-domain0",
				    "performance-domain1",
				    "performance-domain2";
			#performance-domain-cells = <1>;
		};

		cpuhvfs: cpuhvfs@c2c2310 {
			compatible = "mediatek,cpufreq-hybrid";
			reg = <0 0x0c2c2310 0 0xc00>,
			      <0 0x0c2c0f10 0 0x1400>,
			      <0 0x0c2c4850 0 0x800>,
			      <0 0x0c2c2e50 0 0xc0>;
			reg-names = "USRAM", "CSRAM", "ESRAM", "FREQ_HW_STATE";

			/* pll mcucfg */
			mcucfg-ver = <0>;
			apmixedsys = <&cpu_pll>;
			clk-div-base = <&cpu_mcucfg>;

			/* csram sysram base */
			csram-sys-base = <&csram_sys>;
		};

		gic: interrupt-controller@c400000 {
			compatible = "arm,gic-v3";
			reg = <0 0xc400000 0 0x40000>, /* distributor */
			      <0 0xc440000 0 0x200000>; /* redistributor */
			#interrupt-cells = <4>;
			#address-cells = <2>;
			#size-cells = <2>;
			#redistributor-regions = <1>;
			interrupt-parent = <&gic>;
			interrupt-controller;
			interrupts = <GIC_PPI 9 IRQ_TYPE_LEVEL_HIGH 0>;

			ppi-partitions {
				ppi_cluster0: interrupt-partition-0 {
					affinity = <&cpu0 &cpu1 &cpu2 &cpu3>;
				};

				ppi_cluster1: interrupt-partition-1 {
					affinity = <&cpu4 &cpu5 &cpu6>;
				};

				ppi_cluster2: interrupt-partition-2 {
					affinity = <&cpu7>;
				};
			};
		};

		cksys_clk: syscon@10000000 {
			compatible = "mediatek,mt8196-cksys", "syscon";
			reg = <0 0x10000000 0 0x800>;
