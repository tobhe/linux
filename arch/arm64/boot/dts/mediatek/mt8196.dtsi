			reg = <0 0x3ec00000 0 0x5000>,
			      <0 0x128b0000 0 0x1500>,
			      <0 0x1002d600 0 0x4>,
			      <0 0x31b50078 0 0x4>;
			power-domains = <&hfrpsys MT8196_POWER_DOMAIN_DISP_DPTX_DORMANT>,
					<&scpsys MT8196_POWER_DOMAIN_SSUSB_DP_PHY_P0>;
			power-domain-names = "pd_dp_tx", "pd_dp_phy";
			interrupts = <GIC_SPI 447 IRQ_TYPE_LEVEL_HIGH 0>;
			dptx,phy-params = <0x221c1814 0x24241e18 0x0000302a
					   0x0e080400 0x000c0600 0x00000006>;
			#phy-cells = <0>;
			clocks = <&cksys_gp2_clk CLK_CK2_DP0_SEL>,
				 <&cksys_clk CLK_CK_TCK_26M_MX9>;
			clock-names = "mux_dp",
				      "ck_26m";
			mediatek,vdisp-ao = <&disp_vdisp_ao_config_clk>;
		};

		edp_tx: edp-tx@3ec40000 {
			compatible = "mediatek,mt8196-edp-tx";
			reg = <0 0x3ec40000 0 0x4000>,
			      <0 0x130a0000 0 0x1500>,
			      <0 0x31b50074 0 0x4>;

			//nvmem-cells = <&edp_calibration>;
			//nvmem-cell-names = "dp_calibration_data";

			power-domains = <&hfrpsys MT8196_POWER_DOMAIN_DISP_EDPTX_DORMANT>;
			clocks = <&cksys_gp2_clk CLK_CK2_DVO_SEL>;
			clock-names = "power";
			max-linkrate-mhz = <8100>;
			interrupts = <GIC_SPI 448 IRQ_TYPE_LEVEL_HIGH 0>;
			status = "disabled";
		};

		gpu: gpu@48000000 {
			compatible = "mediatek,mali-mt8196", "mediatek,mali";
			reg = <0 0x48000000 0 0x480000>;
			interrupts = <GIC_SPI 606 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 605 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 604 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 607 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 608 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 612 IRQ_TYPE_LEVEL_HIGH 0>;
			interrupt-names = "job",
					  "mmu",
					  "gpu",
					  "event",
					  "pwr",
					  "gpueb_mbox1";
			l2-hash-values = <0xb 0xe 0x0>;
			physical-memory-group-manager = <&mgm>;
			protected-memory-allocator = <&gpu_protected_memory_allocator>;
			operating-points-v2 = <&gpu_mali_opp>;
			#cooling-cells = <2>;
			ged-supply = <&ged>;
			system-coherency = <31>;
			sleep-mode-enable;
			firmware-name = "arm/mali/arch13.8/mali_csffw.bin";
			firmware-idle-hysteresis-time-us = <0>;
			default-glb-pwroff-timeout-us = <10>;
			autosuspend-delay-ms = <10>;
			adaptive-power-policy = <2>;
			reset-exception-mask = <0x0>;
			iter-trace-enable = <1>;
			gpu-frame-base-optimize = <1>;
			dynamic-power-coefficient = <19259>;

			pbha {
				propagate-bits = /bits/ 8 <0xf>;
			};
		};

		gpufreq: gpufreq@48500000 {
			compatible = "mediatek,gpufreq";
			reg = <0 0x48500000 0 0x1000>,   /* MFG_TOP_CONFIG */
			      <0 0x48600000 0 0x200000>, /* MFG_SMMU */
			      <0 0x48800000 0 0x1000>,   /* MFG_VGPU_BUS_DBG_TRACKER */
			      <0 0x4b190000 0 0x20000>,  /* MFG_GPUEB_BUS_DBG_TRACKER */
			      <0 0x4b800000 0 0x10000>,  /* MFG_RPC */
			      <0 0x4b810000 0 0x400>,    /* MFG_PLL */
			      <0 0x4b810400 0 0x400>,    /* MFG_PLL_SC0 */
			      <0 0x4b810800 0 0x400>,    /* MFG_PLL_SC1 */
			      <0 0x4b840000 0 0x1000>,   /* MFG_HBVC */
			      <0 0x4b860000 0 0x1000>,   /* MFG_VCORE_AO_CFG */
			      <0 0x4b8b0000 0 0x1000>,   /* MFG_VCORE_DEVAPC */
			      <0 0x4b900000 0 0x1000>,   /* MFG_VCORE_BUS_DBG_TRACKER */
			      <0 0x0c000000 0 0x1000>,   /* MCUSYS_PAR_WRAP */
			      <0 0x10000000 0 0x1000>,   /* CKSYS */
			      <0 0x10404000 0 0x1000>,   /* NTH_EMICFG_AO_MEM */
			      <0 0x10416000 0 0x1000>,   /* NTH_EMI_AO_DEBUG_CTRL */
			      <0 0x10425000 0 0x1000>,   /* NTH_EMICFG */
			      <0 0x10469000 0 0x1000>,   /* EMI */
			      <0 0x10504000 0 0x1000>,   /* STH_EMICFG_AO_MEM */
			      <0 0x10516000 0 0x1000>,   /* STH_EMI_AO_DEBUG_CTRL */
			      <0 0x10525000 0 0x1000>,   /* STH_EMICFG */
			      <0 0x10569000 0 0x1000>,   /* SUB_EMI */
			      <0 0x10621000 0 0x1000>,   /* SEMI_MI32_SMI */
			      <0 0x10622000 0 0x1000>,   /* NEMI_MI32_SMI */
			      <0 0x10623000 0 0x1000>,   /* SEMI_MI33_SMI */
			      <0 0x10624000 0 0x1000>,   /* NEMI_MI33_SMI */
			      <0 0x10644000 0 0x1000>,   /* INFRA_AO_DEBUG_CTRL */
			      <0 0x10645000 0 0x1000>,   /* EMI_INFRA_AO_BCRM */
			      <0 0x10646000 0 0x1000>,   /* EMI_INFRA_AO_MEM */
			      <0 0x10648000 0 0x1000>,   /* EMI_INFRA_CFG */
			      <0 0x1c004000 0 0x10000>;  /* SLEEP */
			reg-names = "mfg_top_config",
				    "mfg_smmu",
				    "mfg_vgpu_bus_trk",
				    "mfg_gpueb_bus_trk",
				    "mfg_rpc",
				    "mfg_pll",
				    "mfg_pll_sc0",
				    "mfg_pll_sc1",
				    "mfg_hbvc",
				    "mfg_vcore_ao_cfg",
				    "mfg_vcore_devapc",
				    "mfg_vcore_bus_trk",
				    "mcusys_par_wrap",
				    "cksys",
				    "nth_emicfg_ao_mem",
				    "nth_emi_ao_debug_ctrl",
				    "nth_emicfg",
				    "emi",
				    "sth_emicfg_ao_mem",
				    "sth_emi_ao_debug_ctrl",
				    "sth_emicfg",
				    "sub_emi",
				    "semi_mi32_smi",
				    "nemi_mi32_smi",
				    "semi_mi33_smi",
				    "nemi_mi33_smi",
				    "infra_ao_debug_ctrl",
				    "emi_infra_ao_bcrm",
				    "emi_infra_ao_mem",
				    "emi_infra_cfg",
				    "sleep";
			gpufreq-wrapper-supply = <&gpufreq_wrapper>;
		};

		gpupdma: gpupdma@48540000 {
			compatible = "mediatek,gpupdma";
			reg = <0 0x48540000 0 0x2000>,
			      <0 0x4b800704 0 0x4>,
			      <0 0x13f840 0 0x28>;
			ringbuf-page-order = <3>;
			config-mode = <1>;
			hw-semaphore-bit = <1>;
		};

		gpu_smmu: iommu@48600000 {
			#iommu-cells = <1>;
			compatible = "mediatek,mt8196-gpu-smmu", "arm,smmu-v3";
			reg = <0 0x48600000 0 0x1e0000>;
			interrupts = <GIC_SPI 616 IRQ_TYPE_LEVEL_HIGH 0>;
			interrupt-names = "combined";
			status = "disabled";
		};

		gpueb: gpueb@4b000000 {
			compatible = "mediatek,gpueb";
			reg = <0 0x4b000000 0 0xa0000>,
			      <0 0x4b09fd00 0 0x80>,
			      <0 0x4b140100 0 0x200>,
			      <0 0x4b120000 0 0x100>,
			      <0 0x4b09fd80 0 0x280>,
			      <0 0x4b170008 0 0x4>,  /* arbitrary addr to avoid error msg */
			      <0 0x4b170004 0 0x4>,
			      <0 0x4b170074 0 0x4>,
			      <0 0x4b170000 0 0x4>,
			      <0 0x4b170078 0 0x4>,
			      <0 0x4b800504 0 0x4>;
			reg-names = "gpueb_base",
			            "gpueb_gpr_base",
			            "gpueb_cfgreg_base",
			            "gpueb_intc_base",
			            "mbox0_base",
			            "mbox0_init", /* dummy input for mtk_mbox_probe */
			            "mbox0_set",
			            "mbox0_clr",
			            "mbox0_send",
			            "mbox0_recv",
			            "mfg0_pwr_con";
			interrupts = <GIC_SPI 608 IRQ_TYPE_LEVEL_HIGH 0>;
			interrupt-names = "mbox0";

			gpueb-support;
			ghpm-support;
			mbox-count = <1>;
			mbox-size = <160>; /* 160 slot * 4 = 640 byte */
			slot-size = <4>;   /* 1 slot = 4 bytes */
			ts-mbox = <0>; /* mbox for timersync */

			/* id, mbox, send_size */
			send-table = <0 0 4>,
				     <1 0 8>,
				     <2 0 3>,
				     <3 0 6>,
				     <4 0 9>,
				     <5 0 4>,
				     <6 0 6>,
				     <7 0 6>,
				     <8 0 1>,
				     <9 0 4>,
				     <10 0 4>,
				     <11 0 1>;
			send-name-table = "IPI_ID_FAST_DVFS_EVENT",
					  "IPI_ID_GPUFREQ",
					  "IPI_ID_SLEEP",
					  "IPI_ID_TIMER",
					  "IPI_ID_FHCTL",
					  "IPI_ID_CCF",
					  "IPI_ID_GPUMPU",
					  "IPI_ID_FAST_DVFS",
					  "CH_IPIR_C_MET", /* = IPIS_C_MET on gpueb side */
					  "CH_IPIS_C_MET", /* = IPIR_C_MET on gpueb side */
					  "IPI_ID_BRISKET",
					  "IPI_ID_PPB";

			/* id, mbox, recv_size, recv_opt, cb_ctx_opt */
			recv-table = <0 0 4 0 0>,
				     <1 0 8 1 1>,
				     <2 0 1 0 1>,
				     <3 0 1 0 1>,
				     <4 0 1 1 1>,
				     <5 0 4 1 1>,
				     <6 0 1 1 1>,
				     <7 0 6 1 1>,
				     <8 0 4 0 1>,
				     <9 0 1 1 1>,
				     <10 0 4 1 1>,
				     <11 0 1 1 1>;
			recv-name-table = "IPI_ID_FAST_DVFS_EVENT",
					  "IPI_ID_GPUFREQ",
					  "IPI_ID_SLEEP",
					  "IPI_ID_TIMER",
					  "IPI_ID_FHCTL",
					  "IPI_ID_CCF",
					  "IPI_ID_GPUMPU",
					  "IPI_ID_FAST_DVFS",
					  "CH_IPIR_C_MET", /* = IPIS_C_MET on gpueb side */
					  "CH_IPIS_C_MET", /* = IPIR_C_MET on gpueb side */
					  "IPI_ID_BRISKET",
					  "IPI_ID_PPB";

			gpueb-mem-table = <0 0x4000>,   /* 16KB */
					  <1 0x180000>; /* 1.5MB */

			gpueb-mem-name-table = "MEM_ID_GPUFREQ", /* GPUFREQ */
					       "MEM_ID_LOG";     /* LOGGER */
		};

		mfgpll_pll_ctrl_clk: syscon@4b810000 {
			/* TODO: Fix compatible in driver */
			compatible = "mediatek,mt8196-mfgpll-pll-ctrl", "mediatek,mt8196-mfgpll_pll_ctrl", "syscon";
			reg = <0 0x4b810000 0 0x400>;
			#clock-cells = <1>;
		};

		mfgpll_sc0_pll_ctrl_clk: syscon@4b810400 {
			/* TODO: Fix compatible in driver */
			compatible = "mediatek,mt8196-mfgpll-sc0-pll-ctrl", "mediatek,mt8196-mfgpll_sc0_pll_ctrl", "syscon";
			reg = <0 0x4b810400 0 0x400>;
			#clock-cells = <1>;
		};

		ghpm: ghpm@4b800000 {
			compatible = "mediatek,ghpm";
			reg =
				<0 0x4b800000 0 0x1000>,
				<0 0x4b860000 0 0x1000>,
				<0 0x4b860128 0 0x4>,
				<0 0x1c004ea8 0 0x4>,
				<0 0x1c000070 0 0x4>,
				<0 0x1c000074 0 0x4>,
				<0 0x1c000078 0 0x4>;
			reg-names =
				"mfg_rpc",
				"mfg_vcore_ao_config",
				"mfg_mt8196_e2_id_con",
				"spm_mfg0_pwr_con",
				"clk_cfg_6",
				"clk_cfg_6_set",
				"clk_cfg_6_clr";

			gpueb-supply = <&gpueb>;
		};

		mfgpll_sc1_pll_ctrl_clk: syscon@4b810800 {
			/* TODO: Fix compatible in driver */
			compatible = "mediatek,mt8196-mfgpll-sc1-pll-ctrl", "mediatek,mt8196-mfgpll_sc1_pll_ctrl", "syscon";
			reg = <0 0x4b810800 0 0x1000>;
			#clock-cells = <1>;
		};
/*
		devapc_gpu: devapc@4b890000 {
			compatible = "mediatek,mt8196-devapc";
			reg = <0 0x4b890000 0 0x1000>;
			vio-idx-num = <20>;
			interrupts = <GIC_SPI 613 IRQ_TYPE_LEVEL_HIGH 0>;
		};

		devapc_gpu1: devapc@4b8b0000 {
			compatible = "mediatek,mt8196-devapc";
			reg = <0 0x4b8b0000 0 0x1000>;
			vio-idx-num = <26>;
			interrupts = <GIC_SPI 613 IRQ_TYPE_LEVEL_HIGH 0>;
		};
*/
		apu_smmu: iommu@4c000000 {
			compatible = "mediatek,mt8196-apu-smmu", "arm,smmu-v3";
			reg = <0 0x4c000000 0 0x1e0000>;
			interrupts = <GIC_SPI 651 IRQ_TYPE_EDGE_RISING 0>;
			interrupt-names = "combined";
			#iommu-cells = <1>;
			smmu-mediatek-parents = <&apu_top_3>;
		};

		apu_mailbox: mailbox@4c200000 {
			compatible = "mediatek,mt8196-apu-mailbox";
			reg = <0 0x4c200000 0 0xfffff>;
			interrupts = <GIC_SPI 638 IRQ_TYPE_LEVEL_HIGH 0>;
			#mbox-cells = <1>;
		};

		apusys-apummu {
			compatible = "mediatek,rv-apummu-mt8196";
			#address-cells = <2>;
			#size-cells = <2>;
			apu-rv-dev = <&apusys_rv>;
			iommus = <&apu_smmu 0xd>;
		};

		jpeg-decoder {
			compatible = "mediatek,mt8196-jpgdec";
			power-domains = <&hfrpsys MT8196_POWER_DOMAIN_VEN0>;
			iommus = <&mm_smmu 164>;
			#address-cells = <2>;
			#size-cells = <2>;
			ranges;

			jpgdec0: jpeg-decoder@38040000 {
				compatible = "mediatek,mt8196-jpgdec-hw";
				reg = <0 0x38040000 0 0x10000>;
				interrupts = <GIC_SPI 489 IRQ_TYPE_LEVEL_HIGH 0>;
				mediatek,larbs = <&smi_larb7>;
				operating-points-v2 = <&opp_table_venc>;
				clocks = <&venc_gcon_clk CLK_VEN1_CKE3_JPGDEC_JPGDEC>,
				         <&mmdvfs_mux MMDVFS_USER_JPEGDEC>;
				clock-names = "mt_cg_venc_jpgdec",
					      "mmdvfs_clk";
				power-domains = <&hfrpsys MT8196_POWER_DOMAIN_VEN0>;
				mediatek,smmu-config = <&jpeg_smmu0>;
				interconnects = <&mmqos MASTER_LARB_PORT(SMMU_L7_P17_JPGDEC_W)
						 &mmqos SLAVE_COMMON(0)>,
						<&mmqos MASTER_LARB_PORT(SMMU_L7_P18_JPGDEC_BS)
						 &mmqos SLAVE_COMMON(0)>,
						<&mmqos MASTER_LARB_PORT(SMMU_L7_P30_JPGDEC_HUF)
						 &mmqos SLAVE_COMMON(0)>;
				interconnect-names = "path_jpegdec_wdma",
						     "path_jpegdec_bsdma",
						     "path_jpegdec_huff_offset";
			};

			jpgdec1: jpeg-decoder@38840000 {
				compatible = "mediatek,mt8196-jpgdec-hw";
				reg = <0 0x38840000 0 0x10000>;
				interrupts = <GIC_SPI 494 IRQ_TYPE_LEVEL_HIGH 0>;
				mediatek,larbs = <&smi_larb8>;
				operating-points-v2 = <&opp_table_venc>;
				clocks = <&venc_gcon_core1_clk CLK_VEN2_CKE3_JPGDEC_JPGDEC>,
				         <&mmdvfs_mux MMDVFS_USER_JPEGDEC>;
				clock-names = "mt_cg_venc_jpgdec2", "mmdvfs_clk";
				power-domains = <&hfrpsys MT8196_POWER_DOMAIN_VEN1>;
				mediatek,smmu-config = <&jpeg_smmu1>;
				interconnects = <&mmqos MASTER_LARB_PORT(SMMU_L8_P17_JPGDEC_W)
						 &mmqos SLAVE_COMMON(1)>,
						<&mmqos MASTER_LARB_PORT(SMMU_L8_P18_JPGDEC_BS)
						 &mmqos SLAVE_COMMON(1)>,
						<&mmqos MASTER_LARB_PORT(SMMU_L8_P30_JPGDEC_HUF)
						 &mmqos SLAVE_COMMON(1)>;
				interconnect-names = "path_jpegdec_wdma",
						     "path_jpegdec_bsdma",
						     "path_jpegdec_huff_offset";
			};
		};

		jpeg-encoder {
			compatible = "mediatek,mt8196-jpgenc";
			power-domains = <&hfrpsys  MT8196_POWER_DOMAIN_VEN0>;
			iommus = <&mm_smmu 165>;
			#address-cells = <2>;
			#size-cells = <2>;
			ranges;

			jpgenc0: jpeg-encoder@38030000 {
				compatible = "mediatek,mt8196-jpgenc-hw";
				reg = <0 0x38030000 0 0x10000>;
				interrupts = <GIC_SPI 488 IRQ_TYPE_LEVEL_HIGH 0>;
				clocks = <&venc_gcon_clk CLK_VEN1_CKE2_JPGENC_JPGENC>,
				         <&mmdvfs_mux MMDVFS_USER_JPEGENC>;
				clock-names = "jpgenc", "mmdvfs_clk";
				power-domains = <&hfrpsys  MT8196_POWER_DOMAIN_VEN0>;
				mediatek,smmu-config = <&jpeg_smmu0>;
				mediatek,larb = <&smi_larb7>;
				operating-points-v2 = <&opp_table_venc>;
				interconnects = <&mmqos MASTER_LARB_PORT(SMMU_L7_P7_JPGENC_YRD)
						 &mmqos SLAVE_COMMON(0)>,
						<&mmqos MASTER_LARB_PORT(SMMU_L7_P8_JPGENC_CRD)
						 &mmqos SLAVE_COMMON(0)>,
						<&mmqos MASTER_LARB_PORT(SMMU_L7_P9_JPGENC_QT)
						 &mmqos SLAVE_COMMON(0)>,
						<&mmqos MASTER_LARB_PORT(SMMU_L7_P16_JPGENC_BS)
						 &mmqos SLAVE_COMMON(0)>;
				interconnect-names = "path_jpegenc_y_rdma",
						     "path_jpegenc_c_rmda",
						     "path_jpegenc_q_table",
						     "path_jpegenc_bsdma";
			};

			jpgenc1: jpeg-encoder@38830000 {
				compatible = "mediatek,mt8196-jpgenc-hw";
				reg = <0 0x38830000 0 0x10000>;
				interrupts = <GIC_SPI 493 IRQ_TYPE_LEVEL_HIGH 0>;
				clocks = <&venc_gcon_clk CLK_VEN1_CKE2_JPGENC>,
				         <&venc_gcon_core1_clk  CLK_VEN2_CKE2_JPGENC_JPGENC>,
					 <&mmdvfs_mux MMDVFS_USER_JPEGENC>;
				clock-names = "jpgenc", "jpgenc_c1", "mmdvfs_clk";
				power-domains = <&hfrpsys MT8196_POWER_DOMAIN_VEN1>;
				mediatek,smmu-config = <&jpeg_smmu1>;
				mediatek,larb = <&smi_larb7 &smi_larb8>;
				operating-points-v2 = <&opp_table_venc>;
				interconnects = <&mmqos MASTER_LARB_PORT(SMMU_L8_P7_JPGENC_YRD)
						 &mmqos SLAVE_COMMON(1)>,
						<&mmqos MASTER_LARB_PORT(SMMU_L8_P8_JPGENC_CRD)
						 &mmqos SLAVE_COMMON(1)>,
						<&mmqos MASTER_LARB_PORT(SMMU_L8_P9_JPGENC_QT)
						 &mmqos SLAVE_COMMON(1)>,
						<&mmqos MASTER_LARB_PORT(SMMU_L8_P16_JPGENC_BS)
						 &mmqos SLAVE_COMMON(1)>;
				interconnect-names = "path_jpegenc_y_rdma",
						     "path_jpegenc_c_rmda",
						     "path_jpegenc_q_table",
						     "path_jpegenc_bsdma";
			};
		};

		jpeg_smmu0: syscon@380d0000 {
			compatible = "mediatek,mt8196-jpeg-smmu", "syscon";
			reg = <0 0x380d0000 0 0x1000>;
		};

		jpeg_smmu1: syscon@388d0000 {
			compatible = "mediatek,mt8196-jpeg-smmu", "syscon";
			reg = <0 0x388d0000 0 0x1000>;
		};

		mtk_apu_mem_code: mtk-apu-mem-code {
			compatible = "mediatek, apu_mem_code";
			#address-cells = <2>;
			#size-cells = <2>;
			type = <1>;
			mask = /bits/ 64 <0x00000003ffffffff>;
			iommus = <&apu_smmu 0xb>;
		};

		mtk_apu_mem_data: mtk-apu-mem-data {
			compatible = "mediatek, apu_mem_data";
			#address-cells = <2>;
			#size-cells = <2>;
			type = <2>;
			mask = /bits/ 64 <0x00000003ffffffff>;
			iommus = <&apu_smmu 0xa>;
		};

		mvpu {
			compatible = "mediatek, mt8196-mvpu";
			core-num = <2>;
			mask = /bits/ 64 <0x00000003ffffffff>;
			iommus = <&apu_smmu 0xf>;
		};

		sound: sound {
			compatible = "mediatek,mt8196-mt6681-sound";
			mediatek,platform = <&afe>;
			/* audio-routing is added here as a placeholder to complete the
			   probe flow.It should be removed when upstreaming */
			audio-routing = "Headphone Jack", "HPOL",
					"Headphone Jack", "HPOR";
			status = "disabled";
		};

		vdisp-ctrl {
			compatible = "mediatek,mt8196-vdisp-ctrl";
			mediatek,hw-ccf = <&mm_hwv>;
			mediatek,vcp = <&vcp>;

			vdisp: vdisp {
				regulator-name = "vdisp";
			};
		};

		vmm: vmm {
			compatible = "mediatek,mt8196-vmm";
			mediatek,hw-ccf = <&mm_hwv>;
			mediatek,vcp = <&vcp>;

			vdec_vcore: vdec-vcore {
				regulator-name = "vdec-vcore";
			};
		};

		thermal_zones: thermal-zones {
			soc_max: soc_max {
				polling-delay = <0>; /* milliseconds */
				polling-delay-passive = <0>; /* milliseconds */
