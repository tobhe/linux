			compatible = "mediatek,mt8196-pcie-phy";
			reg = <0 0x16930000 0 0x10000>,
			      <0 0x16950000 0 0x10000>;
			reg-names = "sif", "ckm";

			clocks = <&pextp1cfg_ao_clk CLK_PEXT1_PEXTP_PHY_P1_MCU_BUS_PCIE>,
