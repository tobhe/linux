		lvts: thermal-sensor@14414000 {
			compatible = "mediatek,mt8196-lvts";
			reg = <0 0x14414000 0 0x1000>,
				<0 0x0c230000 0 0x1000>,
				<0 0x19004000 0 0x1000>,
				<0 0x4b400000 0 0x1000>;
			interrupts = <GIC_SPI 358 IRQ_TYPE_LEVEL_HIGH 0>,
					<GIC_SPI 104 IRQ_TYPE_LEVEL_HIGH 0>,
					<GIC_SPI 647 IRQ_TYPE_LEVEL_HIGH 0>,
					<GIC_SPI 614 IRQ_TYPE_LEVEL_HIGH 0>;
			#thermal-sensor-cells = <1>;
			nvmem-cells = <&lvts_e_data1 &lvts_e_data2 &lvts_e_data3
					&lvts_e_data4>;
			nvmem-cell-names = "e_data1","e_data2","e_data3","e_data4";
		};

