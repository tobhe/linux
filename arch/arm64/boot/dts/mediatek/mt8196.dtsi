			pinmux = <PINMUX_GPIO23__FUNC_DMIC1_CLK>;
			input-schmitt-enable;
			bias-disable;
		};

		pins-cmd2-dat {
			pinmux = <PINMUX_GPIO24__FUNC_DMIC1_DAT>;
			input-schmitt-enable;
			bias-disable;
		};
	};

	/* ap i2s3 gpio */
	aud_gpio_i2sin3_off: aud-gpio-i2sin3-off {
		pins-cmd1-dat {
			pinmux = <PINMUX_GPIO226__FUNC_GPIO226>;
			input-enable;
			bias-pull-down;
		};
		pins-cmd2-dat {
			pinmux = <PINMUX_GPIO227__FUNC_GPIO227>;
			input-enable;
			bias-pull-down;
		};
	};

	aud_gpio_i2sin3_on: aud-gpio-i2sin3-on {
		pins-cmd1-dat {
			pinmux = <PINMUX_GPIO226__FUNC_I2SIN3_BCK>;
			input-schmitt-enable;
			bias-disable;
		};
		pins-cmd2-dat {
			pinmux = <PINMUX_GPIO227__FUNC_I2SIN3_LRCK>;
			input-schmitt-enable;
			bias-disable;
		};
	};

	aud_gpio_i2sout3_off: aud-gpio-i2sout3-off {
		pins-cmd1-dat {
			pinmux = <PINMUX_GPIO229__FUNC_GPIO229>;
			input-enable;
			bias-pull-down;
		};
	};
	aud_gpio_i2sout3_on: aud-gpio-i2sout3-on {
		pins-cmd1-dat {
			pinmux = <PINMUX_GPIO229__FUNC_I2SOUT3_DO>;
			input-schmitt-enable;
			bias-disable;
		};
	};

	codec_en_off: codec-en-off {
		pins-cmd-dat {
			pinmux = <PINMUX_GPIO9__FUNC_GPIO9>;
			input-enable;
			bias-pull-down;
		};
	};

	codec_en_on: codec-en-on {
		pins-cmd-dat {
			pinmux = <PINMUX_GPIO9__FUNC_GPIO9>;
			output-high;
		};
	};
	/* AUDIO GPIO standardization end */
};
