		pcie2: pcie@16970000 {
			device_type = "pci";
			compatible = "mediatek,mt8196-pcie";
			reg = <0 0x16970000 0 0x4000>;
			reg-names = "pcie-mac";
			#address-cells = <3>;
			#size-cells = <2>;
