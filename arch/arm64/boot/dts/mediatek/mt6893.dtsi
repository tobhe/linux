			mediatek,gce-client-reg = <&gce0 SUBSYS_1400XXXX 0x116000 0x1000>;
		};

		dp_intf0: dp-intf@14125000 {
			compatible = "mediatek,mt6893-dp-intf";
			reg = <0 0x14125000 0 0x1000>;
			interrupts = <GIC_SPI 282 IRQ_TYPE_LEVEL_HIGH 0>;
			clocks = <&mmsys CLK_MM_DP_INTF_INTF_CLK>,
				 <&mmsys  CLK_MM_DP_INTF_MM_CLK>,
				 <&topckgen CLK_TOP_DP>;
			clock-names = "pixel", "engine", "pll";
			status = "disabled";
		};

		dp_tx: displayport-controller@14800000 { /* OK */
			compatible = "mediatek,mt6893-dp-tx";
			reg = <0 0x14800000 0 0x8000>;
			power-domains = <&spm MT6893_POWER_DOMAIN_DP_TX>;
			interrupts = <GIC_SPI 430 IRQ_TYPE_LEVEL_HIGH 0>;
			max-linkrate-mhz = <8100>;
			status = "disabled";
		};
};
