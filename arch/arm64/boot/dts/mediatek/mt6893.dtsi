		gpu: gpu@13000000 {
			compatible = "mediatek,mt6893-mali", "mediatek,mt8192-mali",
				     "arm,mali-valhall-jm";
			reg = <0 0x13000000 0 0x4000>;

			clocks = <&mfgcfg CLK_MFG_BG3D>;
			interrupts = <GIC_SPI 364 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 363 IRQ_TYPE_LEVEL_HIGH 0>,
				     <GIC_SPI 362 IRQ_TYPE_LEVEL_HIGH 0>;
			interrupt-names = "job", "mmu", "gpu";
			operating-points-v2 = <&gpu_opp_table>;
			power-domains = <&spm MT6893_POWER_DOMAIN_MFG2>,
					<&spm MT6893_POWER_DOMAIN_MFG3>,
					<&spm MT6893_POWER_DOMAIN_MFG4>,
					<&spm MT6893_POWER_DOMAIN_MFG5>,
					<&spm MT6893_POWER_DOMAIN_MFG6>;
			power-domain-names = "core0", "core1", "core2", "core3", "core4";
			status = "disabled";
