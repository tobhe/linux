		u3phy0: phy@11e40000 {
			compatible = "mediatek,mt6893-tphy", "mediatek,generic-tphy-v2";
			#address-cells = <1>;
			#size-cells = <1>;
			ranges = <0 0 0x11e40000 0xe00>;
