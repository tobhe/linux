		efuse: efuse@11c10000 {
			compatible = "mediatek,mt6893-efuse", "mediatek,efuse";
			reg = <0 0x11c10000 0 0x1000>;
			#address-cells = <1>;
			#size-cells = <1>;

			u3_intr_p0: usb3-intr@1ac,1 {
				reg = <0x1ac 0x1>;
				bits = <0 5>;
			};
			u3_rx_imp_p0: usb3-rx-imp@1ac,2 {
				reg = <0x1ac 0x2>;
				bits = <8 5>;
			};
			u3_tx_imp_p0: usb3-tx-imp@1ad {
				reg = <0x1ad 0x1>;
				bits = <0 5>;
			};
			u2_intr_p0: usb2-intr@1b0 {
				reg = <0x1b0 0x1>;
				bits = <0 5>;
			};
			lvts_efuse_data1: lvts1-calib@1bc {
				reg = <0x1d0 0x10>;
			};
			lvts_efuse_data2: lvts2-calib@1d0 {
				reg = <0x2f8 0x48>;
			};
		};

